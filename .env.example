# Supabase — Paramètres → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase — Paramètres → API
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (pas anon !)

# Sécurité JWT — générer une chaîne aléatoire longue
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
